# Atlas Lab Environment Configuration
# Copy to .env and fill in values. Never commit .env!

# Application
ENVIRONMENT=development
DEBUG=true
APP_NAME=atlas-lab
APP_VERSION=1.0.0

# Server
HOST=0.0.0.0
PORT=8000

# Database
# Development: SQLite (file-based)
DATABASE_URL=sqlite+aiosqlite:///./atlas_lab.db
# Production: PostgreSQL
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# OIDC / Keycloak
OIDC_ENABLED=false
OIDC_ISSUER_URL=http://localhost:8080/realms/atlas-lab
OIDC_CLIENT_ID=atlas-lab-frontend
OIDC_CLIENT_SECRET=atlas-lab-frontend-secret-change-in-production
OIDC_REDIRECT_URI=http://localhost:5173/callback
OIDC_SCOPES=openid profile email roles
OIDC_AUDIENCE=

# Keycloak (for local development)
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=atlas-lab
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# LLM Configuration (optional - for AI-enhanced features)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173